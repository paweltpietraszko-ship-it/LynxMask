<?xml version="1.0" encoding="utf-8"?>
<!--
    AndroidManifest.xml
    Zmiany Potok RODO (10.06.2026):

    [RODO-1] fullBackupContent: "@xml/backup_rules" → "false"
      Wiersz: <application android:fullBackupContent=...>
      Powód: decyzja architektoniczna — pełne wyłączenie backupu. Wartość
      "false" jest spójna z allowBackup="false" (już obecne). Na Android 6–11
      fullBackupContent jest ignorowane gdy allowBackup="false", więc zmiana
      jest konceptualna — eliminuje nieaktywne odwołanie do backup_rules.xml.
      Plik backup_rules.xml może pozostać w projekcie jako martwy zasób.

    [RODO-2] dataExtractionRules="@xml/data_extraction_rules" — POZOSTAJE
      Na Android 12+ (API 31+) ten atrybut ma pierwszeństwo nad allowBackup.
      Plik data_extraction_rules.xml (nowy) wyklucza WSZYSTKIE domeny.
      Bez tego pliku cloud backup byłby aktywny mimo allowBackup="false".

    [BUG-20] camera android:required="true" → "false" — JUŻ NAPRAWIONE
      w dostarczonym pliku (komentarz w oryginalnym nagłówku XML).
      Odnotowane w raporcie jako naprawione przed Potokiem RODO.

    Zmiany względem poprzedniej wersji:
      linia ~24: fullBackupContent="@xml/backup_rules" → fullBackupContent="false"
      Bez innych zmian w logice, uprawnieniach ani activity.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".LynxMaskApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LynxMask">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.LynxMask.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ShareTargetActivity — cel share sheet i otwieranie plików -->
        <activity
            android:name=".ShareTargetActivity"
            android:exported="true"
            android:theme="@style/Theme.LynxMask"
            android:label="LynxMask — Sprawdź przed wysłaniem"
            android:taskAffinity="com.lynxmask.app.share"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation">

            <!-- DOCX (Word) — główny format umów -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
            </intent-filter>

            <!-- Tekst zaznaczony lub plain text -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- Obrazy (zdjęcia, skany) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <!-- PDF -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>

            <!-- Pliki z nieznanym typem — niektóre menedżery plików wysyłają DOCX jako octet-stream -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <!-- ACTION_VIEW — otwieranie pliku z menedżera plików -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>

        </activity>

        <!-- ClipboardCheckActivity -->
        <activity
            android:name=".ClipboardCheckActivity"
            android:exported="false"
            android:theme="@style/Theme.LynxMask.Transparent"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleTop" />

        <!-- LynxMaskTileService -->
        <service
            android:name=".LynxMaskTileService"
            android:exported="true"
            android:label="Sprawdź schowek"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>


        <service
            android:name=".BenchmarkService"
            android:exported="false" />

        <!-- FileProvider — udostępnianie zredagowanych JPEG przez IMAGE-REDACT -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

</application>

</manifest>
