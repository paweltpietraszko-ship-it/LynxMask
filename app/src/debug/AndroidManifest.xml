<?xml version="1.0" encoding="utf-8"?>
<!--
    src/debug/AndroidManifest.xml
    Scalany TYLKO z debug buildem — nie trafia do release APK.

    Zawiera komponenty używane wyłącznie podczas testów i benchmarków.
    Komentarz w głównym manifeście: "TYLKO DEBUG. Usunąć przed release." —
    zamiast usuwać, przeniesiono tutaj, żeby gradle merge nie włączał tego
    do release.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>

        <!-- BenchmarkReceiver — uruchamia BenchmarkService przez ADB intent -->
        <receiver
            android:name=".BenchmarkReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.lynxmask.app.BENCHMARK" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
